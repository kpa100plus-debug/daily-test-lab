rules_version = '2';

// REF-DAILYFUN-SECURITY-HARDEN-03
// 사고 대응용 읽기 전용 규칙입니다. 기존 문서는 삭제하지 않고 모든 쓰기만 차단합니다.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'kpa100plus@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /balance_games/{gameId} {
      allow read: if true;
      allow write: if false;
    }

    match /votes/{voteId} {
      allow get: if signedIn() && resource.data.userId == request.auth.uid;
      allow list, write: if false;
    }

    match /users/{userId} {
      allow get: if owns(userId);
      allow list, write: if false;
    }

    match /game_scores/{userId}/scores/{gameId} {
      allow read: if owns(userId);
      allow write: if false;
    }

    match /daily_contents/{documentId} {
      allow get: if documentId == 'current';
      allow list, write: if false;
    }

    match /tests/{testSlug} {
      allow get, list: if isAdmin() || resource.data.status in ['published', 'archived'];
      allow write: if false;
    }

    match /test_questions/{testSlug} {
      allow get: if isAdmin()
        || (
          exists(/databases/$(database)/documents/tests/$(testSlug))
          && get(/databases/$(database)/documents/tests/$(testSlug)).data.status == 'published'
        );
      allow list: if isAdmin();
      allow write: if false;
    }

    match /test_results/{testSlug} {
      allow get: if isAdmin()
        || (
          exists(/databases/$(database)/documents/tests/$(testSlug))
          && get(/databases/$(database)/documents/tests/$(testSlug)).data.status == 'published'
        );
      allow list: if isAdmin();
      allow write: if false;
    }

    match /balance_content/{gameSlug} {
      allow get, list: if isAdmin() || resource.data.status in ['published', 'archived'];
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
