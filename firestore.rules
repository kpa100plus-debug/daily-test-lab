rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validChoice(choice) {
      return choice == 'a' || choice == 'b';
    }

    function votePath(gameId) {
      return /databases/$(database)/documents/votes/$(gameId + '_' + request.auth.uid);
    }

    function statsPath(gameId) {
      return /databases/$(database)/documents/balance_games/$(gameId);
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'kpa100plus@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function validDailyContent() {
      return request.resource.data.keys().hasOnly([
          'category', 'title', 'description', 'duration', 'actionLabel', 'note',
          'icon', 'accent', 'route', 'status', 'updatedBy', 'updatedAt'
        ])
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 40
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 180
        && request.resource.data.duration is string
        && request.resource.data.duration.size() > 0
        && request.resource.data.duration.size() <= 30
        && request.resource.data.actionLabel is string
        && request.resource.data.actionLabel.size() > 0
        && request.resource.data.actionLabel.size() <= 30
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 80
        && request.resource.data.icon is string
        && request.resource.data.icon.size() > 0
        && request.resource.data.icon.size() <= 16
        && request.resource.data.accent in ['violet', 'coral', 'orange', 'blue', 'mint']
        && request.resource.data.route is string
        && request.resource.data.route.size() <= 160
        && request.resource.data.route.matches('^/(test|vote|game)/[a-z0-9-]+/$')
        && request.resource.data.status == 'published'
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    function validContentStatus(status) {
      return status in ['draft', 'published', 'archived'];
    }

    function validContentAudit() {
      return request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    function validSeo(seo) {
      return seo is map
        && seo.keys().hasOnly(['title', 'description'])
        && seo.title is string
        && seo.title.size() > 0
        && seo.title.size() <= 120
        && seo.description is string
        && seo.description.size() > 0
        && seo.description.size() <= 200;
    }

    function validTestMetadata(testSlug) {
      return request.resource.data.keys().hasOnly([
          'schemaVersion', 'id', 'slug', 'status', 'category', 'icon', 'accent',
          'title', 'shortTitle', 'description', 'duration', 'questionCount',
          'participantLabel', 'disclaimer', 'seo', 'recommendations',
          'updatedBy', 'updatedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.id is string
        && request.resource.data.id.size() > 0
        && request.resource.data.id.size() <= 80
        && request.resource.data.slug == testSlug
        && testSlug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && validContentStatus(request.resource.data.status)
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 40
        && request.resource.data.icon is string
        && request.resource.data.icon.size() > 0
        && request.resource.data.icon.size() <= 16
        && request.resource.data.accent in ['violet', 'coral', 'orange', 'blue', 'mint']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.shortTitle is string
        && request.resource.data.shortTitle.size() > 0
        && request.resource.data.shortTitle.size() <= 50
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 240
        && request.resource.data.duration is string
        && request.resource.data.duration.size() > 0
        && request.resource.data.duration.size() <= 30
        && request.resource.data.questionCount is int
        && request.resource.data.questionCount >= 1
        && request.resource.data.questionCount <= 50
        && request.resource.data.participantLabel is string
        && request.resource.data.participantLabel.size() > 0
        && request.resource.data.participantLabel.size() <= 60
        && request.resource.data.disclaimer is string
        && request.resource.data.disclaimer.size() > 0
        && request.resource.data.disclaimer.size() <= 240
        && validSeo(request.resource.data.seo)
        && request.resource.data.recommendations is list
        && request.resource.data.recommendations.size() <= 6
        && validContentAudit();
    }

    function validTestQuestions(testSlug) {
      return request.resource.data.keys().hasOnly([
          'schemaVersion', 'testId', 'items', 'updatedBy', 'updatedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.testId == testSlug
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 50
        && validContentAudit();
    }

    function validTestResults(testSlug) {
      return request.resource.data.keys().hasOnly([
          'schemaVersion', 'testId', 'items', 'updatedBy', 'updatedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.testId == testSlug
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 2
        && request.resource.data.items.size() <= 20
        && validContentAudit();
    }

    function validBalanceOption(option, optionId) {
      return option is map
        && option.keys().hasOnly(['id', 'label', 'shortLabel', 'emoji'])
        && option.id == optionId
        && option.label is string
        && option.label.size() > 0
        && option.label.size() <= 100
        && option.shortLabel is string
        && option.shortLabel.size() > 0
        && option.shortLabel.size() <= 40
        && option.emoji is string
        && option.emoji.size() > 0
        && option.emoji.size() <= 16;
    }

    function validBalanceContent(gameSlug) {
      return request.resource.data.keys().hasOnly([
          'schemaVersion', 'id', 'slug', 'status', 'category', 'icon', 'title',
          'question', 'description', 'options', 'shareText', 'seo',
          'updatedBy', 'updatedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.id is string
        && request.resource.data.id.size() > 0
        && request.resource.data.id.size() <= 80
        && request.resource.data.slug == gameSlug
        && gameSlug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && validContentStatus(request.resource.data.status)
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 40
        && request.resource.data.icon is string
        && request.resource.data.icon.size() > 0
        && request.resource.data.icon.size() <= 16
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.question is string
        && request.resource.data.question.size() > 0
        && request.resource.data.question.size() <= 180
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 240
        && request.resource.data.options is list
        && request.resource.data.options.size() == 2
        && validBalanceOption(request.resource.data.options[0], 'a')
        && validBalanceOption(request.resource.data.options[1], 'b')
        && request.resource.data.shareText is string
        && request.resource.data.shareText.size() > 0
        && request.resource.data.shareText.size() <= 180
        && validSeo(request.resource.data.seo)
        && validContentAudit();
    }

    function validScore(userId, gameId) {
      return request.resource.data.keys().hasOnly([
          'userId', 'gameId', 'best', 'last', 'attempts', 'scoreDirection', 'updatedAt'
        ])
        && request.resource.data.userId == userId
        && request.resource.data.gameId == gameId
        && request.resource.data.best is number
        && request.resource.data.last is number
        && request.resource.data.best >= 0
        && request.resource.data.last >= 0
        && request.resource.data.attempts is int
        && request.resource.data.attempts >= 1
        && request.resource.data.scoreDirection in ['lower', 'higher']
        && request.resource.data.updatedAt == request.time;
    }

    match /balance_games/{gameId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['gameId', 'a', 'b', 'total', 'updatedAt'])
        && request.resource.data.gameId == gameId
        && request.resource.data.a is int
        && request.resource.data.b is int
        && request.resource.data.a >= 0
        && request.resource.data.b >= 0
        && request.resource.data.total == 1
        && request.resource.data.a + request.resource.data.b == 1
        && request.resource.data.updatedAt == request.time
        && !exists(votePath(gameId))
        && existsAfter(votePath(gameId))
        && getAfter(votePath(gameId)).data.choice in ['a', 'b']
        && (
          (getAfter(votePath(gameId)).data.choice == 'a'
            && request.resource.data.a == 1
            && request.resource.data.b == 0)
          ||
          (getAfter(votePath(gameId)).data.choice == 'b'
            && request.resource.data.a == 0
            && request.resource.data.b == 1)
        );

      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['gameId', 'a', 'b', 'total', 'updatedAt'])
        && request.resource.data.gameId == resource.data.gameId
        && request.resource.data.gameId == gameId
        && request.resource.data.a is int
        && request.resource.data.b is int
        && request.resource.data.total == resource.data.total + 1
        && request.resource.data.a + request.resource.data.b == request.resource.data.total
        && request.resource.data.updatedAt == request.time
        && !exists(votePath(gameId))
        && existsAfter(votePath(gameId))
        && (
          (getAfter(votePath(gameId)).data.choice == 'a'
            && request.resource.data.a == resource.data.a + 1
            && request.resource.data.b == resource.data.b)
          ||
          (getAfter(votePath(gameId)).data.choice == 'b'
            && request.resource.data.a == resource.data.a
            && request.resource.data.b == resource.data.b + 1)
        );

      allow delete: if false;
    }

    match /votes/{voteId} {
      // 새 사용자의 첫 투표는 존재하지 않는 문서를 먼저 조회한다.
      // 존재하는 투표는 작성자만 읽게 하고, 목록 조회는 계속 차단한다.
      allow get: if signedIn()
        && (
          !exists(/databases/$(database)/documents/votes/$(voteId))
          || resource.data.userId == request.auth.uid
        );
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['gameId', 'userId', 'choice', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && voteId == request.resource.data.gameId + '_' + request.auth.uid
        && validChoice(request.resource.data.choice)
        && request.resource.data.createdAt == request.time
        && existsAfter(statsPath(request.resource.data.gameId))
        && (
          (!exists(statsPath(request.resource.data.gameId))
            && getAfter(statsPath(request.resource.data.gameId)).data.total == 1)
          ||
          (exists(statsPath(request.resource.data.gameId))
            && getAfter(statsPath(request.resource.data.gameId)).data.total
              == get(statsPath(request.resource.data.gameId)).data.total + 1)
        );

      allow update, delete: if false;
    }

    match /users/{userId} {
      allow get: if owns(userId);
      allow list: if false;

      allow create: if owns(userId)
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'provider', 'createdAt', 'lastLoginAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.email is string
        && request.resource.data.provider == 'google.com'
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastLoginAt == request.time;

      allow update: if owns(userId)
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'provider', 'createdAt', 'lastLoginAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.email is string
        && request.resource.data.provider == 'google.com'
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lastLoginAt == request.time;

      allow delete: if false;
    }

    match /game_scores/{userId}/scores/{gameId} {
      allow read: if owns(userId);

      allow create: if owns(userId) && validScore(userId, gameId);

      allow update: if owns(userId)
        && validScore(userId, gameId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.gameId == resource.data.gameId
        && request.resource.data.scoreDirection == resource.data.scoreDirection
        && request.resource.data.attempts >= resource.data.attempts
        && (
          (request.resource.data.scoreDirection == 'lower'
            && request.resource.data.best <= resource.data.best)
          ||
          (request.resource.data.scoreDirection == 'higher'
            && request.resource.data.best >= resource.data.best)
        );

      allow delete: if false;
    }

    match /daily_contents/{documentId} {
      allow get: if documentId == 'current';
      allow list: if false;
      allow create, update: if documentId == 'current'
        && isAdmin()
        && validDailyContent();
      allow delete: if false;
    }

    match /tests/{testSlug} {
      // 공개 콘텐츠와 보관 표시는 정적 기본 콘텐츠를 덮어쓰기 위해 조회할 수 있다.
      // 초안과 전체 무제한 목록은 관리자에게만 허용한다.
      allow get: if isAdmin() || resource.data.status in ['published', 'archived'];
      allow list: if isAdmin() || resource.data.status in ['published', 'archived'];
      allow create, update: if isAdmin() && validTestMetadata(testSlug);
      allow delete: if false;
    }

    match /test_questions/{testSlug} {
      allow get: if isAdmin()
        || (
          exists(/databases/$(database)/documents/tests/$(testSlug))
          && get(/databases/$(database)/documents/tests/$(testSlug)).data.status == 'published'
        );
      allow list: if isAdmin();
      allow create, update: if isAdmin() && validTestQuestions(testSlug);
      allow delete: if false;
    }

    match /test_results/{testSlug} {
      allow get: if isAdmin()
        || (
          exists(/databases/$(database)/documents/tests/$(testSlug))
          && get(/databases/$(database)/documents/tests/$(testSlug)).data.status == 'published'
        );
      allow list: if isAdmin();
      allow create, update: if isAdmin() && validTestResults(testSlug);
      allow delete: if false;
    }

    match /balance_content/{gameSlug} {
      allow get: if isAdmin() || resource.data.status in ['published', 'archived'];
      allow list: if isAdmin() || resource.data.status in ['published', 'archived'];
      allow create, update: if isAdmin() && validBalanceContent(gameSlug);
      allow delete: if false;
    }

    // 공개된 기능 외의 컬렉션은 계속 차단한다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
